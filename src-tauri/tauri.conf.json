{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FellyJin",
  "version": "0.1.0",
  "identifier": "dev.fellyjin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FellyJin",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/fellyjin/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Video",
    "shortDescription": "Lightweight Jellyfin client",
    "longDescription": "FellyJin is a lightweight, modern Jellyfin client with direct and transcoded streaming, transcoded downloads with server progress sync, and Live TV.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
