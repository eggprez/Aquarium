<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS sandbox: the app talks to a Jellyfin server and nothing else. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- The shared settings dictionary — see Core/CloudSync.swift. Needs
	     iCloud (Key-value storage) enabled on the App ID; without it the store
	     answers false to synchronize() and the whole feature stands down
	     quietly, so a build signed without it behaves as before. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- SharePlay — see Core/SharePlay.swift. Needs Group Activities enabled
	     on the App ID. -->
	<key>com.apple.developer.group-session</key>
	<true/>
	<!-- No CarPlay key here: macOS refuses an upload that carries
	     com.apple.developer.carplay-audio. iPhone/iPad sign with
	     Aquarium-iOS.entitlements, which has it. -->
</dict>
</plist>
