<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one thing the extension needs: the folder the app writes the shelf
	     into. It has no network entitlement and asks for no keychain, because
	     it never talks to the server — see TopShelfSnapshot. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.scottai.FellyJin</string>
	</array>
	<!-- The same value the app carries in Aquarium-tvOS.entitlements. With
	     it on the app alone, the app runs as the current Apple TV user and
	     writes the shelf into that user's copy of the group container, while
	     the extension runs as the default user and reads the default user's
	     copy — which is empty, so the shelf stays the static image. Both
	     sides carrying it puts them in the same container. Needs User
	     Management ticked on the extension's own App ID
	     (scottai.FellyJin.TopShelf), as it is on the app's. -->
	<key>com.apple.developer.user-management</key>
	<array>
		<string>runs-as-current-user-with-user-independent-keychain</string>
	</array>
</dict>
</plist>
