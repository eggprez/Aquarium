<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with what Xcode generates (GENERATE_INFOPLIST_FILE), like the
	     app's own Info.plist. -->
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>scottai.FellyJin</string>
	<!-- The watch talks to the server itself when the phone is away. -->
	<key>WKRunsIndependentlyWithCompanionApp</key>
	<true/>
	<!-- Keeps playing with the wrist down. UIBackgroundModes, not
	     WKBackgroundModes: on watchOS the WK key only takes the workout and
	     session kinds, and an "audio" under it is refused at install. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aquarium</string>
			</array>
		</dict>
	</array>
	<!-- A Jellyfin server on a home network is usually plain HTTP. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
